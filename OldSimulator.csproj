<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="OldSimulator.Expansion.Abstractions\OldSimulator.Expansion.Abstractions.csproj"/>
    <ProjectReference Include="OldSimulator.Expansion.Loopback\OldSimulator.Expansion.Loopback.csproj"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="OldSimulator.Expansion.Disk\OldSimulator.Expansion.Disk.csproj"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <None Update="simulator.example.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"/>
    <None Update="embedded-asm.example.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"/>
    <None Update="disk.example.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="OldSimulator.Tests\**\*.cs"/>
    <EmbeddedResource Remove="OldSimulator.Tests\**\*"/>
    <None Remove="OldSimulator.Tests\**\*"/>
    <Compile Remove="OldSimulator.Expansion.Abstractions\**\*.cs"/>
    <EmbeddedResource Remove="OldSimulator.Expansion.Abstractions\**\*"/>
    <None Remove="OldSimulator.Expansion.Abstractions\**\*"/>
    <Compile Remove="OldSimulator.Expansion.Loopback\**\*.cs"/>
    <EmbeddedResource Remove="OldSimulator.Expansion.Loopback\**\*"/>
    <None Remove="OldSimulator.Expansion.Loopback\**\*"/>
    <Compile Remove="OldSimulator.Expansion.EmbeddedAsm\**\*.cs"/>
    <EmbeddedResource Remove="OldSimulator.Expansion.EmbeddedAsm\**\*"/>
    <None Remove="OldSimulator.Expansion.EmbeddedAsm\**\*"/>
    <Compile Remove="OldSimulator.Expansion.Disk\**\*.cs"/>
    <EmbeddedResource Remove="OldSimulator.Expansion.Disk\**\*"/>
    <None Remove="OldSimulator.Expansion.Disk\**\*"/>
    <Compile Remove="toolchains\**\*.cs"/>
    <EmbeddedResource Remove="toolchains\**\*"/>
    <None Remove="toolchains\**\*"/>
  </ItemGroup>

  <Target Name="CopyExampleExpansionCardToOutput" AfterTargets="Build">
    <ItemGroup>
      <ExampleExpansionCardFiles Include="OldSimulator.Expansion.Loopback\bin\$(Configuration)\$(TargetFramework)\Open16A.Loopback.dll"/>
      <ExampleExpansionCardFiles Include="OldSimulator.Expansion.Loopback\bin\$(Configuration)\$(TargetFramework)\Open16A.Loopback.deps.json"/>
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)plugins"/>
    <Copy SourceFiles="@(ExampleExpansionCardFiles)"
          DestinationFolder="$(TargetDir)plugins"
          SkipUnchangedFiles="true"/>
  </Target>

  <Target Name="CopyEmbeddedAsmExpansionCardToOutput"
          AfterTargets="Build"
          Condition="'$(SkipEmbeddedAsmPackaging)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\OldSimulator.Expansion.EmbeddedAsm\OldSimulator.Expansion.EmbeddedAsm.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"/>
    <ItemGroup>
      <EmbeddedAsmExpansionCardFiles Include="OldSimulator.Expansion.EmbeddedAsm\bin\$(Configuration)\$(TargetFramework)\*.dll"/>
      <EmbeddedAsmExpansionCardFiles Include="OldSimulator.Expansion.EmbeddedAsm\bin\$(Configuration)\$(TargetFramework)\*.deps.json"/>
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)plugins"/>
    <Copy SourceFiles="@(EmbeddedAsmExpansionCardFiles)"
          DestinationFolder="$(TargetDir)plugins"
          SkipUnchangedFiles="true"/>
  </Target>

  <Target Name="CopyDiskExpansionCardToOutput" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\OldSimulator.Expansion.Disk\OldSimulator.Expansion.Disk.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"/>
    <ItemGroup>
      <DiskExpansionCardFiles Include="OldSimulator.Expansion.Disk\bin\$(Configuration)\$(TargetFramework)\Open16A.Disk.dll"/>
      <DiskExpansionCardFiles Include="OldSimulator.Expansion.Disk\bin\$(Configuration)\$(TargetFramework)\Open16A.Disk.deps.json"/>
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)plugins"/>
    <Copy SourceFiles="@(DiskExpansionCardFiles)"
          DestinationFolder="$(TargetDir)plugins"
          SkipUnchangedFiles="true"/>
  </Target>

  <Target Name="CopyExampleExpansionCardToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedExampleExpansionCardFiles Include="OldSimulator.Expansion.Loopback\bin\$(Configuration)\$(TargetFramework)\Open16A.Loopback.dll"/>
      <PublishedExampleExpansionCardFiles Include="OldSimulator.Expansion.Loopback\bin\$(Configuration)\$(TargetFramework)\Open16A.Loopback.deps.json"/>
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)plugins"/>
    <Copy SourceFiles="@(PublishedExampleExpansionCardFiles)"
          DestinationFolder="$(PublishDir)plugins"
          SkipUnchangedFiles="true"/>
  </Target>

  <Target Name="CopyEmbeddedAsmExpansionCardToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedEmbeddedAsmExpansionCardFiles Include="OldSimulator.Expansion.EmbeddedAsm\bin\$(Configuration)\$(TargetFramework)\*.dll"/>
      <PublishedEmbeddedAsmExpansionCardFiles Include="OldSimulator.Expansion.EmbeddedAsm\bin\$(Configuration)\$(TargetFramework)\*.deps.json"/>
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)plugins"/>
    <Copy SourceFiles="@(PublishedEmbeddedAsmExpansionCardFiles)"
          DestinationFolder="$(PublishDir)plugins"
          SkipUnchangedFiles="true"/>
  </Target>

  <Target Name="CopyDiskExpansionCardToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedDiskExpansionCardFiles Include="OldSimulator.Expansion.Disk\bin\$(Configuration)\$(TargetFramework)\Open16A.Disk.dll"/>
      <PublishedDiskExpansionCardFiles Include="OldSimulator.Expansion.Disk\bin\$(Configuration)\$(TargetFramework)\Open16A.Disk.deps.json"/>
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)plugins"/>
    <Copy SourceFiles="@(PublishedDiskExpansionCardFiles)"
          DestinationFolder="$(PublishDir)plugins"
          SkipUnchangedFiles="true"/>
  </Target>

</Project>
